#!/bin/sh

[ $# -gt 0 ] || set -- $(jq -r '.servers.value[].name' cdktf.json)

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# For each host and IP version, materialize a copy of the suite with the
# connect-to and IP version baked into every request, so a single `hurl --test`
# can run them all in parallel. After a "# Tag: TAG" comment, requests are
# skipped on hosts without this tag in cdktf.json. The first HTTPS request for
# each name also checks that the certificate is valid for 15 more days.
for host in "$@"; do
    tags=$(jq -r --arg host "$host" '.servers.value[]
        | select(.name == $host or (.name | startswith($host + ".")))
        | .tags | join(" ")' cdktf.json)
    for version in ipv4 ipv6; do
        case $version in
            ipv4)
                ip -4 route show 0.0.0.0/0 | grep -q . || continue
                ;;
            ipv6)
                ip -6 route show ::/0 | grep -q . || continue
                ;;
        esac
        awk -v host="$host" -v version="$version" -v tags="$tags" '
            function tagged(t) {
                return index(" " tags " ", " " t " ") > 0
            }
            # hurl wants [Options] after the request headers, so emit it once
            # the header block is over
            function options() {
                if (!pending) return
                pending = 0
                print "[Options]"
                if (!cdn) {
                    print "connect-to: :443:" host ":443"
                    print "connect-to: :80:" host ":80"
                }
                print version ": true"
                if (excluded) print "skip: true"
                excluded = 0
            }
            function expiry() {
                if (!certificate) return
                certificate = 0
                print "certificate \"Expire-Date\" daysAfterNow > 29"
            }
            /^#[ \t]*Tag: / {
                tag = $0
                sub(/^#[ \t]*Tag:[ \t]*/, "", tag)
                sub(/[ \t]*$/, "", tag)
                print
                next
            }
            /^[A-Z]+[ \t]+https?:\/\// {
                print
                pending = 1
                excluded = (tag != "" && !tagged(tag))
                name = $2
                sub(/^https:\/\/([^\/@]*@)?/, "", name)
                sub(/[\/:{].*/, "", name)
                cdn = (name ~ /\.b-cdn\.net$/)
                certificate = ($2 ~ /^https:/ && !excluded && !cdn && !(name in checked))
                if (certificate) checked[name] = 1
                next
            }
            /^\[Options\]$/ { options(); next }   # merge any existing options into ours
            !/^[A-Za-z0-9_-]+[ \t]*:/ { options() }
            /^\[Asserts\]$/ { print; expiry(); next }
            /^[ \t]*$/ && certificate { print "[Asserts]"; expiry() }
            { print }
            END {
                options()
                if (certificate) print "[Asserts]"
                expiry()
            }
        ' tests.hurl > "$tmpdir/$host-$version.hurl"
    done
done

status=0
check() {
    if "$@" > /dev/null 2>&1; then
        echo "PASS $label"
    else
        echo "FAIL $label"
        status=1
    fi
}

# For hosts tagged "dns", check that each zone validates with the DNSKEY it
# publishes and that signatures do not expire in the next 30 days.
margin=$(date -u -d '+30 days' +%Y%m%d%H%M%S)
signed() {
    dig @"$host" -$version +norec +short "$zone" DNSKEY | awk -v zone="$zone" '
        BEGIN { print "trust-anchors {" }
        { k = ""; for (i = 4; i <= NF; i++) k = k $i
          printf "  %s. static-key %s %s %s \"%s\";\n", zone, $1, $2, $3, k }
        END { print "};" }' > "$tmpdir/anchor"
    delv @"$host" -$version -a "$tmpdir/anchor" +root="$zone" "$@" | grep -q "fully validated"
}
delegated() {
    parent=$(dig +short "${zone#*.}" NS | head -1)
    dig @"$parent" +norec +short "$zone" DS | awk -v zone="$zone" '
        BEGIN { print "trust-anchors {" }
        { d = ""; for (i = 4; i <= NF; i++) d = d $i
          printf "  %s. static-ds %s %s %s \"%s\";\n", zone, $1, $2, $3, d }
        END { print "};" }' > "$tmpdir/anchor"
    delv @"$host" -$version -a "$tmpdir/anchor" +root="$zone" "$zone" SOA | grep -q "fully validated"
}
fresh() {
    dig @"$host" -$version +norec +dnssec +noall +answer "$zone" "$1" | awk -v margin="$margin" '
        $4 == "RRSIG" { n++; if ($9 <= margin) old++ }
        END { exit !(n > 0 && old == 0) }'
}
for host in "$@"; do
    jq -e --arg host "$host" '.servers.value[]
        | select(.name == $host or (.name | startswith($host + ".")))
        | select(.tags | index("dns"))' cdktf.json > /dev/null || continue
    for version in 4 6; do
        ip -$version route show default | grep -q . || continue
        for zone in y.luffy.cx acme.luffy.cx; do
            label="$host IPv$version $zone SOA is signed"
            check signed "$zone" SOA
            label="$host IPv$version $zone NXDOMAIN is signed"
            check signed "nonexistent.$zone" A
            label="$host IPv$version $zone DS in parent zone matches"
            check delegated
            for type in SOA DNSKEY; do
                label="$host IPv$version $zone $type signature valid for 30 days"
                check fresh $type
            done
        done
    done
done

hurl --test \
     --connect-timeout 2 \
     --max-time 2 \
     --retry 3 \
     --retry-interval 2000 \
     "$tmpdir"/*.hurl || status=1
exit $status
