#!/bin/sh

[ $# -gt 0 ] || {
    echo "Usage: $0 HOST..."
    exit 1
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# For each host and IP version, materialize a copy of the suite with the
# connect-to and IP version baked into every request, so a single `hurl --test`
# can run them all in parallel. A request preceded by a "# Skip except on
# HOST" comment is skipped on the other hosts.
for host in "$@"; do
    for version in ipv4 ipv6; do
        awk -v host="$host" -v version="$version" '
            # HOST also matches when the caller only gave the first label
            function wanted(target) {
                return target == host || index(target, host ".") == 1
            }
            # hurl wants [Options] after the request headers, so emit it once
            # the header block is over
            function options() {
                if (!pending) return
                pending = 0
                print "[Options]"
                print "connect-to: :443:" host ":443"
                print "connect-to: :80:" host ":80"
                print version ": true"
                if (excluded) print "skip: true"
                excluded = 0
            }
            /^#[ \t]*Skip except on / {
                only = $0
                sub(/^#[ \t]*Skip except on[ \t]*/, "", only)
                sub(/[ \t]*$/, "", only)
                print
                next
            }
            /^[A-Z]+[ \t]+https?:\/\// {
                print
                pending = 1
                excluded = (only != "" && !wanted(only))
                only = ""
                next
            }
            /^\[Options\]$/ { options(); next }   # merge any existing options into ours
            !/^[A-Za-z0-9_-]+[ \t]*:/ { options() }
            { print }
            END { options() }
        ' tests.hurl > "$tmpdir/$host-$version.hurl"
    done
done

hurl --test \
     --connect-timeout 2 \
     --max-time 2 \
     "$tmpdir"/*.hurl
